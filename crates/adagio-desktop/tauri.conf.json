{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adagio",
  "version": "0.1.0",
  "identifier": "ai.neuralagent.adagio",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Adagio",
        "width": 900,
        "height": 650,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      },
      {
        "label": "tray",
        "title": "Adagio",
        "url": "index.html?tray",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/adagio-daemon",
      "binaries/adagio-cli"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1 | libappindicator3-1"],
        "desktopTemplate": "bundler/adagio.desktop.template"
      },
      "rpm": {
        "depends": ["libayatana-appindicator3"],
        "desktopTemplate": "bundler/adagio.desktop.template"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^(https?://|mailto:|tel:|file://|/).+"
    }
  }
}
